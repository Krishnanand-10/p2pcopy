{
    "name":  "p2pcopy",
    "version":  "0.1.0",
    "description":  "Zero-cloud, end-to-end encrypted peer-to-peer file and clipboard sharing right from your terminal.",
    "bin":  {
                "p2pcopy":  "./bin/p2pcopy.js"
            },
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "scripts":  {
                    "build":  "tsc",
                    "watch":  "tsc -w",
                    "start":  "node ./bin/p2pcopy.js",
                    "clean":  "rimraf dist",
                    "test":  "npm run build \u0026\u0026 node test/signaling.test.js \u0026\u0026 node test/webrtc.test.js \u0026\u0026 node test/file-transfer.test.js \u0026\u0026 node test/clipboard.test.js",
                    "build:web": "npm --prefix web run build",
                    "postinstall": "npm run build && npm --prefix web install && npm --prefix web run build",
                    "start:signal": "node dist/index.js signal"
                },
    "keywords":  [
                     "p2p",
                     "webrtc",
                     "cli",
                     "file-transfer",
                     "clipboard",
                     "e2ee"
                 ],
    "author":  "Krishna tiwari",
    "license":  "MIT",
    "dependencies":  {
                         "cli-progress":  "^3.12.0",
                         "commander":  "^13.1.0",
                         "node-datachannel":  "^0.33.3",
                         "picocolors":  "^1.1.1",
                         "ws":  "^8.18.0"
                     },
    "devDependencies":  {
                            "@types/cli-progress":  "^3.11.6",
                            "@types/node":  "^22.13.5",
                            "@types/ws":  "^8.5.14",
                            "typescript":  "^5.7.3"
                        },
    "files":  [
                  "bin",
                  "dist",
                  "README.md",
                  "LICENSE"
              ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Krishnanand-10/p2pcopy.git"
                   },
    "homepage":  "https://github.com/Krishnanand-10/p2pcopy#readme",
    "bugs":  {
                 "url":  "https://github.com/Krishnanand-10/p2pcopy/issues"
             }
}
